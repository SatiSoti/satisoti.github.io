              },
              "hairColorId": {
                "enum": [
                  "dark",
                  "brown",
                  "copper",
                  "silver"
                ]
              },
              "outfitColorId": {
                "enum": [
                  "sage",
                  "coral",
                  "indigo",
                  "mustard",
                  "plum",
                  "teal"
