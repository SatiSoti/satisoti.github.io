                    "type": "number",
                    "minimum": 0
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "faceBox": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              },
