{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comic Hatten General Character Pack",
  "type": "object",
  "properties": {
    "format": {
      "const": "comic-hatten.general-character-pack"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packId": {
      "const": "comic-hatten-general"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "releasedAt": {
      "type": "string",
      "format": "date"
    },
    "locale": {
      "const": "ja-JP"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "image": {
            "type": "string",
            "pattern": "^assets/[a-z0-9_-]+\\.png$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "image",
          "width",
          "height",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
