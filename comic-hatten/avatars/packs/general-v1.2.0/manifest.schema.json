              },
              "rect": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              },
              "neck": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
