                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "rect": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
